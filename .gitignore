# Oeffentliches Repo: erst alles ausschliessen, dann gezielt freigeben.
# Umgekehrt herum rutscht irgendwann etwas mit, das nicht raus soll.
/*

!/.gitignore
!/.nojekyll
!/CNAME
!/index.html
!/impressum.html
!/datenschutz.html
!/robots.txt
!/README.md
!/scrollcraft.js
!/scrollcraft.css
!/weiche.js
# Das Baurezept der Etappenclips. Gehoert versioniert: in seinem Kopf steht,
# warum die Clips 72 Bilder/s haben und was passiert, wenn jemand das senkt.
!/bau-clips.sh

!/assets/
!/fonts/
!/demo/

# Aus img nur die beiden Fassungen, die die Seite wirklich laedt.
# Die Originale (-src) bleiben lokal, sie sind gross und werden nicht gebraucht.
!/img/
/img/*
!/img/tim.webp
!/img/some1.webp

# Nicht von der Seite benutzt.
/demo/ablaufbild.mmd
